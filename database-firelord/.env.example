# Copy to .env and adjust for your environment.
# These variables are read by the Python logger (run on the host) and docker-compose.

# Serial reader settings (host machine)
# Linux/WSL: /dev/ttyACM0 or similar
# Windows: COM3 (or whichever COM port your device uses)
SERIAL_PORT=/dev/ttyACM0
BAUD_RATE=115200
LOG_LEVEL=INFO
RECONNECT_DELAY_SECONDS=3

# Database settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=firelord
DB_USER=firelord
DB_PASSWORD=firelord
